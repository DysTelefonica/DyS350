  "sources": {
    "ordinal": "@if(equals(body('ExpedienteJSON')?['ordinal'],null),null,int(body('ExpedienteJSON')?['ordinal']))",
    "pecal": "@if(or(empty(body('ExpedienteJSON')?['pecal']),equals(toLower(trim(string(body('ExpedienteJSON')?['pecal']))),'n/a')),false,true)",
    "responsableCalidad": "@body('ExpedienteJSON')?['responsableCalidad']?['correousuario']",
    "responsableSeguridad": "@body('ExpedienteJSON')?['responsableSeguridad']?['correousuario']",
    "miembros": "@variables('ArrayResponsables')",
    "tituloConFallback": "@if(empty(trim(coalesce(body('ExpedienteJSON')?['titulo'], ''))), first(outputs('Obtener_Expediente_del_Sistema')?['body/value'])?['Title'], body('ExpedienteJSON')?['titulo'])"
  }
